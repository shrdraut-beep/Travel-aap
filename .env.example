# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ANTHROPIC_API_KEY: Optional fallback/alternative AI model (Claude 3.5 Sonnet / Haiku).
ANTHROPIC_API_KEY=

# OPENAI_API_KEY: Optional fallback AI model (GPT-4o).
OPENAI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Firebase
#
# The web config (project id, app id, apiKey, ...) is NOT set here - it is compiled
# into src/firebase.ts, because those values are public identifiers required by the
# client SDK, not secrets. Access is controlled by firestore.rules, API key referrer
# restrictions and App Check. Only set the VITE_FIREBASE_* overrides below if you need
# to point a build at a *different* Firebase project (e.g. a staging one); each falls
# back to the committed default. If you do override them, update
# public/firebase-messaging-sw.js too - it is served from public/ and therefore cannot
# read env vars.
# ---------------------------------------------------------------------------
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_DATABASE_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=

# VITE_FIREBASE_VAPID_KEY: Web Push certificate public key from the Firebase Console
# (Cloud Messaging > Web Push certificates). Required for push notifications on the
# WEB/PWA build only. This is a public key and is safe to ship in the client bundle.
# Until it is set, src/utils/push.ts reports 'unconfigured' and web push stays off.
#
# The native Android app does NOT use this. It needs
# android/app/google-services.json instead - see android/app/google-services.json.example.
VITE_FIREBASE_VAPID_KEY=

# GOOGLE_MAPS_PLATFORM_KEY: Required for Google Maps features.
GOOGLE_MAPS_PLATFORM_KEY="MY_GOOGLE_MAPS_PLATFORM_KEY"
# Google Places API (Client-side key - MUST configure strict HTTP Referrer Restrictions in Google Cloud Console)
VITE_GOOGLE_PLACES_API_KEY="YOUR_GOOGLE_PLACES_KEY"

# Pexels API (Server-side only)
PEXELS_API_KEY="YOUR_PEXELS_KEY"

# OpenSky Network API (Server-side proxy only - Never expose to client)
OPENSKY_USERNAME="YOUR_OPENSKY_USERNAME"
OPENSKY_PASSWORD="YOUR_OPENSKY_PASSWORD"

# GROQ_API_KEY: Required for transit schedule AI generation (Server-side only)
GROQ_API_KEY="YOUR_GROQ_API_KEY"

# OPENAI_API_KEY: Optional fallback AI model (Protected by Server Circuit Breaker)
OPENAI_API_KEY="YOUR_OPENAI_KEY"

# Consolidated Primary Payment Gateway: Razorpay
RAZORPAY_KEY_ID="rzp_live_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_SECRET"
VITE_RAZORPAY_KEY_ID="rzp_live_YOUR_KEY_ID"
RAZORPAY_WEBHOOK_SECRET="YOUR_WEBHOOK_SECRET"
RAZORPAY_TAX_HOLDING_ACCOUNT_ID="acc_YOUR_HOLDING_ACCOUNT_ID"

# Zero-Trust Security & Envelope Encryption Keys
# MASTER_KEK: 256-bit (32-byte) hex or base64 key used to wrap/unwrap user Data Encryption Keys (DEKs)
MASTER_KEK="YOUR_256_BIT_MASTER_KEK_HEX_OR_BASE64"
# ADMIN_MASTER_TOKEN: Constant-time verified master secret token for Zero-Trust Admin Legal Data Vault
ADMIN_MASTER_TOKEN="YOUR_ADMIN_MASTER_TOKEN"

# Notification Service Variables (Email & FCM Push)
# In production, use Cloud KMS / Secret Manager or IAM roles instead of hardcoded SMTP credentials
NOTIFICATION_PROVIDER="smtp"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="contact@yourdomain.com"
SMTP_PASS="YOUR_APP_PASSWORD"

# Zoop / Signzy API Keys (For KYC & RC Checks - Strictly Server-side Proxied)
ZOOP_API_KEY="YOUR_ZOOP_API_KEY"
ZOOP_APP_ID="YOUR_ZOOP_APP_ID"

# Security Configuration
# By default in production, clickjacking protection is strictly enforced.
# Dynamic environment check in server.ts allows AI Studio iframe previews during development.
ALLOW_IFRAME_EMBED=true

# Travelport (TripServices OAuth 2.0 & Microservices API v11 Air / v12 Stays)
TRAVELPORT_CLIENT_ID="YOUR_TRAVELPORT_CLIENT_ID"
TRAVELPORT_CLIENT_SECRET="YOUR_TRAVELPORT_CLIENT_SECRET"
TRAVELPORT_USERNAME="YOUR_TRAVELPORT_USERNAME"
TRAVELPORT_PASSWORD="YOUR_TRAVELPORT_PASSWORD"
TRAVELPORT_ACCESS_GROUP="1G"
TRAVELPORT_TARGET_BRANCH="UM2_1G"
TRAVELPORT_PCC="UM2_1G"
# Set TRAVELPORT_ENV to 'production' for live GDS or 'pre-production' for sandbox
TRAVELPORT_ENV=production
TRAVELPORT_AUTH_URL=https://auth.travelport.com/oauth/token
TRAVELPORT_AIR_URL=https://api.travelport.com/11/air
TRAVELPORT_HOTEL_URL=https://api.travelport.com/12/hotel
