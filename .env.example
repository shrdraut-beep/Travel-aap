# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Firebase
#
# The web config (project id, app id, apiKey, ...) is NOT set here - it is compiled
# into src/firebase.ts, because those values are public identifiers required by the
# client SDK, not secrets. Access is controlled by firestore.rules, API key referrer
# restrictions and App Check. Only set the VITE_FIREBASE_* overrides below if you need
# to point a build at a *different* Firebase project (e.g. a staging one); each falls
# back to the committed default. If you do override them, update
# public/firebase-messaging-sw.js too - it is served from public/ and therefore cannot
# read env vars.
# ---------------------------------------------------------------------------
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_DATABASE_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=

# VITE_FIREBASE_VAPID_KEY: Web Push certificate public key from the Firebase Console
# (Cloud Messaging > Web Push certificates). Required for push notifications on the
# WEB/PWA build only. This is a public key and is safe to ship in the client bundle.
# Until it is set, src/utils/push.ts reports 'unconfigured' and web push stays off.
#
# The native Android app does NOT use this. It needs
# android/app/google-services.json instead - see android/app/google-services.json.example.
VITE_FIREBASE_VAPID_KEY=

# GOOGLE_MAPS_PLATFORM_KEY: Required for Google Maps features.
GOOGLE_MAPS_PLATFORM_KEY="MY_GOOGLE_MAPS_PLATFORM_KEY"
VITE_GOOGLE_PLACES_API_KEY=
VITE_GRAPHHOPPER_API_KEY=

# DUFFEL_ACCESS_TOKEN: Required for live Duffel flight search
DUFFEL_ACCESS_TOKEN="MY_DUFFEL_ACCESS_TOKEN"

# TRAVELPAYOUTS_TOKEN: Required for Travelpayouts / Aviasales live flight API
TRAVELPAYOUTS_TOKEN="YOUR_TRAVELPAYOUTS_API_TOKEN"
VITE_TRAVELPAYOUTS_TOKEN="YOUR_TRAVELPAYOUTS_API_TOKEN"

# TRAVELPAYOUTS_MARKER: Travelpayouts affiliate marker ID for flight bookings
TRAVELPAYOUTS_MARKER="554147"

# VITE_EARNKARO_ID: EarnKaro affiliate ID for EarnKaro link generation
VITE_EARNKARO_ID="554147"

# EARNKARO_API_KEY: Server-side only. Used by the /api/affiliate-link proxy.
# Do NOT add a VITE_ prefixed copy - VITE_ vars are inlined into the public
# client bundle, which would expose this bearer token to anyone.
EARNKARO_API_KEY=


# RapidAPI Keys (For Flights, Hotels, and Trains)
FLIGHT_API_KEY=
RAPID_API_KEY=
HOTEL_API_KEY=
TRAIN_API_KEY=
VITE_CJ_API_TOKEN=

# Pexels API
VITE_PEXELS_API_KEY=

# OpenSky Network API
VITE_OPENSKY_USERNAME=
VITE_OPENSKY_PASSWORD=

# GROQ_API_KEY: Required for transit schedule AI generation
GROQ_API_KEY="MY_GROQ_API_KEY"
VITE_GROQ_API_KEY="MY_GROQ_API_KEY"

# OPENAI_API_KEY: Required for OpenAI features if used
OPENAI_API_KEY=
VITE_OPENAI_API_KEY=
VITE_FOURSQUARE_API_KEY=
-e 
# Razorpay configuration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
VITE_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_TAX_HOLDING_ACCOUNT_ID=

# Zero-Trust Security & Envelope Encryption Keys
# MASTER_KEK: 256-bit (32-byte) hex or base64 key used to wrap/unwrap user Data Encryption Keys (DEKs)
MASTER_KEK=
# ADMIN_MASTER_TOKEN: Constant-time verified master secret token for Zero-Trust Admin Legal Data Vault
ADMIN_MASTER_TOKEN=
# STRIPE_WEBHOOK_SECRET: Gateway secret for Stripe payment webhook HMAC validation
STRIPE_WEBHOOK_SECRET=

# Notification Service Variables (Email & FCM Push)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="contact@routripo.com"
SMTP_PASS="YOUR_APP_PASSWORD"


# Zoop / Signzy API Keys (For KYC & RC Checks)
ZOOP_API_KEY=
ZOOP_APP_ID=


# Security Configuration
# Set to 'true' to allow embedding the app in an iframe (e.g., for AI Studio preview).
# By default, production deployments will block iframes for security unless this is true.
ALLOW_IFRAME_EMBED=true
