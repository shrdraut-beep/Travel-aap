# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_PLATFORM_KEY: Required for Google Maps features.
GOOGLE_MAPS_PLATFORM_KEY="MY_GOOGLE_MAPS_PLATFORM_KEY"
VITE_GOOGLE_PLACES_API_KEY=
VITE_GRAPHHOPPER_API_KEY=

# DUFFEL_ACCESS_TOKEN: Required for live Duffel flight search
DUFFEL_ACCESS_TOKEN="MY_DUFFEL_ACCESS_TOKEN"

# TRAVELPAYOUTS_TOKEN: Required for Travelpayouts / Aviasales live flight API
TRAVELPAYOUTS_TOKEN="YOUR_TRAVELPAYOUTS_API_TOKEN"
VITE_TRAVELPAYOUTS_TOKEN="YOUR_TRAVELPAYOUTS_API_TOKEN"

# TRAVELPAYOUTS_MARKER: Travelpayouts affiliate marker ID for flight bookings
TRAVELPAYOUTS_MARKER="554147"

# VITE_EARNKARO_ID: EarnKaro affiliate ID for EarnKaro link generation
VITE_EARNKARO_ID="554147"
EARNKARO_API_KEY=
VITE_EARNKARO_API_KEY=


# RapidAPI Keys (For Flights, Hotels, and Trains)
FLIGHT_API_KEY=
RAPID_API_KEY=
HOTEL_API_KEY=
TRAIN_API_KEY=
VITE_CJ_API_TOKEN=

# Pexels API
VITE_PEXELS_API_KEY=

# OpenSky Network API
VITE_OPENSKY_USERNAME=
VITE_OPENSKY_PASSWORD=

# GROQ_API_KEY: Required for transit schedule AI generation
GROQ_API_KEY="MY_GROQ_API_KEY"
VITE_GROQ_API_KEY="MY_GROQ_API_KEY"

# OPENAI_API_KEY: Required for OpenAI features if used
OPENAI_API_KEY=
VITE_OPENAI_API_KEY=
VITE_FOURSQUARE_API_KEY=
VITE_FOURSQUARE_API_KEY=
