{
  "name": "routripo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "build:android": "npm run build && cap sync android && cd android && chmod +x gradlew && ./gradlew assembleDebug assembleRelease",
    "cap:sync": "cap sync",
    "cap:add-android": "cap add android",
    "cap:open-android": "cap open android",
    "cap:generate-assets": "npx @capacitor/assets generate --iconBackgroundColor #ffffff --splashBackgroundColor #ffffff",
    "parse-flights": "tsx scripts/parse-flights.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/push-notifications": "^8.1.2",
    "@duffel/api": "^4.28.0",
    "@duffel/components": "^3.17.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.25",
    "@types/html2canvas": "^1.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.20.1",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.5.4",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dompurify": "^3.4.13",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.12",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "framer-motion": "^12.43.0",
    "helmet": "^8.3.0",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^2.3.2",
    "html2pdf.js": "^0.14.0",
    "idb": "^8.0.3",
    "jsdom": "^30.0.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "openai": "^7.4.0",
    "papaparse": "^5.5.4",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "react": "^19.0.0",
    "react-barcode": "^1.6.1",
    "react-dom": "^19.0.0",
    "react-error-boundary": "^6.1.2",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
