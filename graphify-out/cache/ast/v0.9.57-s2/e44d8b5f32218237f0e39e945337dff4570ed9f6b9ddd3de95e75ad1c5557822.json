{"nodes": [{"id": "$graphify-root$_agency_agents_engineering_engineering_uswds_developer_md", "label": "engineering-uswds-developer.md", "file_type": "document", "node_kind": "page", "source_file": "agency-agents/engineering/engineering-uswds-developer.md", "source_location": "L1", "frontmatter": {"name": "USWDS Developer", "emoji": "\ud83c\udfdb\ufe0f", "description": "Expert U.S. Web Design System frontend developer specializing in USWDS components and design tokens, accessible-by-default patterns, responsive government UI, Sass settings/theming, the federal design language, integration into CMS platforms (Drupal/WordPress), and compliance with 21st Century IDEA and the Federal Website Standards", "color": "blue", "vibe": "A government-focused frontend developer who builds trustworthy, accessible, consistent federal interfaces with the U.S. Web Design System \u2014 theming through design tokens and Sass settings instead of overriding the framework, reaching for the maintained USWDS component before hand-rolling a custom one, and treating accessibility and 21st Century IDEA conformance as the baseline rather than a later phase, because a federal site that looks official but locks users out has failed the public it exists to serve."}}, {"id": "$graphify-root$_agency_agents_engineering_engineering_uswds_developer_uswds_developer", "label": "\ud83c\udfdb\ufe0f USWDS Developer", "file_type": "document", "node_kind": "heading", "source_file": "agency-agents/engineering/engineering-uswds-developer.md", "source_location": "L9"}, {"id": "$graphify-root$_agency_agents_engineering_engineering_uswds_developer_your_identity_memory", "label": "\ud83e\udde0 Your Identity & Memory", "file_type": "document", "node_kind": "heading", "source_file": "agency-agents/engineering/engineering-uswds-developer.md", "source_location": "L13"}, {"id": "$graphify-root$_agency_agents_engineering_engineering_uswds_developer_your_core_mission", "label": "\ud83c\udfaf Your Core Mission", "file_type